[
  {
    "id": "TC-1",
    "covers": "AC-1.1",
    "title": "Create link with expiresInDays=7 returns 201 and Location /api/links/{code}",
    "kind": "positive",
    "phase": "main",
    "steps": [
      {
        "name": "Create link with 7-day expiry",
        "method": "POST",
        "path": "/api/links",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body_json": "{\"url\":\"https://example.com/a\",\"expiresInDays\":7}",
        "repeat": 1,
        "expect_status": 201,
        "expect_status_not": null,
        "body_assertions": [
          {
            "target": "$.shortCode",
            "op": "exists",
            "value": null
          }
        ],
        "header_assertions": [
          {
            "target": "Location",
            "op": "exists",
            "value": null
          },
          {
            "target": "Location",
            "op": "matches",
            "value": "/api/links/[0-9A-Za-z]+$"
          }
        ],
        "capture": [
          {
            "var": "code",
            "json_path": "$.shortCode"
          }
        ],
        "follow_redirects": false
      },
      {
        "name": "Location target resolves to link details",
        "method": "GET",
        "path": "/api/links/${code}",
        "headers": [],
        "body_json": null,
        "repeat": 1,
        "expect_status": 200,
        "expect_status_not": null,
        "body_assertions": [
          {
            "target": "$.shortCode",
            "op": "equals",
            "value": "${code}"
          }
        ],
        "header_assertions": [],
        "capture": [],
        "follow_redirects": false
      }
    ]
  },
