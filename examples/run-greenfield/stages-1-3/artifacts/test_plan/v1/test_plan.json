[
  {
    "id": "TC-1",
    "covers": "AC-1.1",
    "title": "Create short link for a valid https URL returns 201 with a non-empty short code",
    "kind": "positive",
    "phase": "main",
    "steps": [
      {
        "name": "Create short link",
        "method": "POST",
        "path": "/api/links",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "body_json": "{\"url\":\"https://example.com/some/long/path\"}",
        "repeat": 1,
        "expect_status": 201,
        "expect_status_not": null,
        "body_assertions": [
          {
            "target": "$.shortCode",
            "op": "exists",
            "value": null
          },
          {
            "target": "$.shortCode",
            "op": "matches",
            "value": "^\\S+$"
          }
        ],
        "header_assertions": [],
        "capture": [],
        "follow_redirects": false
      }
    ]
  },
